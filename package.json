{
  "name": "clientela",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "harness:check": "bash .codex/scripts/check-harness.sh",
    "typecheck": "bun run --filter='*' typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
