# Proxy reverso do compose de produção.
#
# {$DOMAIN} vem do environment do serviço caddy:
#   - domínio real (ex.: https://seudominio.com) → HTTPS automático (Let's Encrypt).
#   - http://localhost → HTTP puro, sem ACME (usado no smoke local).
#
# reverse_proxy anexa X-Forwarded-For por padrão — o rate limit por visitante da
# API (LP-06) depende disso.
{$DOMAIN} {
	reverse_proxy web:3000
}

# CRM ({$CRM_DOMAIN}, ADR-0017): mesmo app web, separado por host — a raiz do
# subdomínio leva direto ao CRM. Redirect temporário (302): se o CRM um dia for
# servido na raiz do subdomínio, nenhum browser fica preso a um 308 em cache.
# As páginas do CRM já são noindex via metadata; o header reforça para TODA
# resposta deste host (inclusive /login e assets).
{$CRM_DOMAIN} {
	header X-Robots-Tag "noindex, nofollow"
	redir / /crm temporary
	reverse_proxy web:3000
}
