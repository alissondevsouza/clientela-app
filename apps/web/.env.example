# Env do app web (Next.js). O Next carrega .env* deste diretório (apps/web/),
# não da raiz do monorepo. Copie para apps/web/.env.local e preencha.
#
# SSG: a landing é estática — estas variáveis são lidas em BUILD TIME.
# Trocar o valor exige um novo build (rebuild) para refletir no site.

# Número de WhatsApp em formato internacional, incluindo o DDI.
# Brasil: 55 + DDD + número (ex.: 5511912345678). Aceita 10 a 15 dígitos.
WHATSAPP_PHONE=5511912345678

# Mensagem pré-preenchida no link do WhatsApp (opcional).
# Se ausente, usa um default em pt-BR definido no código.
WHATSAPP_DEFAULT_MESSAGE="Olá! Vi seu site e quero saber mais sobre os produtos."

# URL base da API (Bun/Elysia) para a Server Action de captura de lead (LP-06).
# Obrigatória (build e runtime). Dev: http://localhost:3001.
# Nota: a landing é SSG, mas a Server Action roda no runtime Node do standalone —
# API_URL precisa estar disponível também em RUNTIME (documentar no deploy LP-11).
API_URL=http://localhost:3001

# URL pública do site: base para canonical, Open Graph, sitemap.xml e robots.txt.
# Obrigatória (lida em build time). Dev: http://localhost:3000.
# Nota: o domínio real de produção entra no LP-10/12 (trocar aqui e rebuild).
SITE_URL=http://localhost:3000
