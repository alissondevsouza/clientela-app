# API
PORT=3001

# Banco de desenvolvimento (compatível com docker-compose.dev.yml)
# Se mudar CLIENTELA_PG_PORT, ajuste a porta do DATABASE_URL junto
# CLIENTELA_PG_PORT=5433
DATABASE_URL=postgres://clientela:clientela@localhost:5433/clientela

# Seed da usuária única do CRM (script apps/api/scripts/seed-consultant.ts).
# Preencha SÓ ao rodar o seed; nunca commite valores reais (senha é segredo).
# Idempotente: rodar 2x com o mesmo e-mail resulta em 1 consultora (upsert).
# SEED_CONSULTANT_NAME=Nome da Consultora
# SEED_CONSULTANT_EMAIL=consultora@exemplo.com
# SEED_CONSULTANT_PASSWORD=troque-por-uma-senha-forte   # mínimo 8 caracteres
# SEED_CONSULTANT_WHATSAPP=+5511999999999
#
# Uso local (carrega este arquivo via --env-file):
#   cd apps/api && bun run seed:consultant
# Uso em produção (variáveis vêm do ambiente do container, sem --env-file):
#   docker compose run --rm api bun scripts/seed-consultant.ts

# Web (Next.js): as variáveis do app web vivem em apps/web/ — o Next carrega
# .env* do diretório do app, não daqui. Veja apps/web/.env.example.
